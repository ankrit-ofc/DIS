# distro-app — Expo public env vars
#
# Copy to `.env` for local development. `.env` is gitignored; never commit real
# keys. For EAS builds these come from `eas.json` build.*.env or, preferably for
# anything secret, from EAS secrets (see GOOGLE PLACES below).
#
# NOTE: every EXPO_PUBLIC_* value is inlined into the JS bundle at build time and
# is therefore readable by anyone with the APK. "Public" is literal. The only
# real protection for a Google key is a Cloud Console restriction, not secrecy.

# REQUIRED. API base URL, including the /api suffix.
# Local dev on a device/emulator needs the machine IP, not localhost — or run
# `adb reverse tcp:3001 tcp:3001` and use 127.0.0.1.
EXPO_PUBLIC_API_URL="http://127.0.0.1:3001/api"

# ─── Google keys ─────────────────────────────────────────────────────────────
# These are TWO SEPARATE KEYS by necessity. Using one key for both breaks
# Places: a key restricted to an Android package + SHA-1 returns REQUEST_DENIED
# for web-service calls, because those carry no package signature.
#
# 1. MAPS (Android Maps SDK) — renders the map itself.
#    Read by the NATIVE SDK from android/app/src/main/AndroidManifest.xml
#    (`com.google.android.geo.API_KEY`), NOT from this file. It is listed here
#    only so local `.env` stays a complete picture.
#    Cloud Console restrictions:
#      Application → Android apps → package com.distronepal.app
#        + Play app-signing SHA-1  ED:51:1B:BC:FD:16:A4:DE:65:94:99:7C:DE:09:CF:53:E1:B0:5C:4F
#        + upload-key SHA-1        DE:50:B6:36:99:BE:7B:37:13:E5:4A:36:E6:E4:B7:79:4C:AF:F2:C6
#          (internal/preview builds are signed with the upload key, not Play's)
#      API → Maps SDK for Android ONLY
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=""

# 2. PLACES (Places API web service) — address autocomplete in
#    src/components/LocationPicker.tsx (Autocomplete + Place Details).
#    Cloud Console restrictions:
#      Application → None  (a web-service key cannot be package-restricted)
#      API → Places API ONLY, plus a daily quota cap — the quota cap is the
#            real mitigation here, since the key ships inside the APK.
#
#    Do NOT put this in eas.json (it is committed). Use an EAS secret:
#      eas secret:create --scope project \
#        --name EXPO_PUBLIC_GOOGLE_PLACES_API_KEY --value 'AIza...'
#
#    LocationPicker falls back to the Maps key while this is unset, so Places
#    keeps working until the second key exists. Remove that fallback once this
#    is set in every environment.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=""

# ─── Google OAuth (currently unused) ─────────────────────────────────────────
# No Google Sign-In exists in distro-app/src — there is no expo-auth-session
# usage. Google login is WEB ONLY (distro-web uses @react-oauth/google with the
# WEB client id). These three are dead config kept for a future mobile wiring;
# the ANDROID client id in particular restricts nothing today.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=""
